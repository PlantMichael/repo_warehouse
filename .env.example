DATABASE_URL="file:./dev.db"
# Optional: raises the GitHub API rate limit from 60/hr to 5000/hr.
# Create a token with no scopes at https://github.com/settings/tokens
GITHUB_TOKEN=

# Required for "Sign in with GitHub": register an OAuth App at
# https://github.com/settings/developers with callback URL
# http://localhost:3000/api/auth/callback/github (for local dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Used to sign/encrypt session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=
